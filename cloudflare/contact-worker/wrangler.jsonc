{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lucas-camargo-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://lucascamargo.com,https://www.lucascamargo.com,https://lucas-camargo-site-373724198767.us-central1.run.app,https://lucas-camargo-site-mxhlj4sa3a-uc.a.run.app",
    "TURNSTILE_ALLOWED_HOSTNAMES": "lucascamargo.com,www.lucascamargo.com,lucas-camargo-site-373724198767.us-central1.run.app,lucas-camargo-site-mxhlj4sa3a-uc.a.run.app"
  },
  "r2_buckets": [
    {
      "binding": "CONTACT_MESSAGES",
      "bucket_name": "lucas-camargo-private"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "3737241987671",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
